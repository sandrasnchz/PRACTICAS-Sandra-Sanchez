# 01 - SAREK GENOME ANALYSIS

# Load required modules
module load Nextflow singularity

# Link input data
ln -s ../00-reads/ .
ln -s ../samples_id.txt .

# Create required directories
mkdir -p 02-postprocessing 03-annotation 99-stats

# Create samplesheet for nf-core/sarek

# S_UDP_001
cat <<EOF > samplesheet_S_UDP_001.csv
patient,sex,status,sample,lane,fastq_1,fastq_2
S_UDP_001,XY,0,S_UDP_001,1,00-reads/S_UDP_001_R1.fastq.gz,00-reads/S_UDP_001_R2.fastq.gz
EOF

# S_UDP_002
cat <<EOF > samplesheet_S_UDP_002.csv
